# Managed by Ansible (role: nginx_frontend) - do not edit by hand.
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format main '$remote_addr - $http_x_forwarded_for [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                    'upstream=$upstream_addr rt=$request_time urt=$upstream_response_time';
    access_log /var/log/nginx/access.log main;

    sendfile          on;
    keepalive_timeout 65;

    # The internal ALB's IPs change over time. Resolve through the VPC resolver
    # at request time (a plain proxy_pass hostname is resolved once at startup).
    resolver 169.254.169.253 valid=30s ipv6=off;

    server {
        listen 80 default_server;
        server_name _;

        # Answered locally so the public ALB's health check does not depend on
        # the backend (web instances do not flap when the app tier does).
        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        # Static assets served straight from the web tier.
        location /static/ {
            alias {{ static_root }}/;
            expires 1h;
            access_log off;
        }

        # Everything else goes to the app tier through the internal ALB.
        location / {
            set $app_upstream "{{ upstream_host }}";
            proxy_pass http://$app_upstream;

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

            proxy_connect_timeout 5s;
            proxy_read_timeout    30s;
        }
    }
}
