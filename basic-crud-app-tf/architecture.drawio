        <!-- Footer: deploy order -->
        <mxCell id="footer" value="Terraform build order (aws_instance.app depends_on the DB + all SSM parameters):&lt;br&gt;1. RDS (crud-app-db) created and reaches &amp;quot;available&amp;quot;  &#8594;  2. DB details written to SSM Parameter Store  &#8594;&lt;br&gt;3. EC2 instance launches  &#8594;  4. userdata downloads from S3, installs Ansible, runs setup.yml (Apache/PHP/schema import)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C7D0D9;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1">
