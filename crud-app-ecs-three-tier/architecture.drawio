<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.5"><diagram name="crud-app-ecs-three-tier" id="crud-ecs-1"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="crud-app-ecs-three-tier — AWS Architecture" style="text;html=1;fontSize=20;fontColor=#232F3E;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Web (nginx) → App (Apache/PHP) → Data (RDS MySQL), each tier a Docker image from ECR run by ECS on EC2. Built only from terraform-aws-modules. Two capacity providers (web, app), bridge networking with dynamic host ports. TLS terminates at the public ALB." style="text;html=1;fontSize=11;fontColor=#5A6B7B;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1700" height="34" as="geometry"/></mxCell><mxCell id="c4" value="Internet users" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="45" y="250" width="55" height="55" as="geometry"/></mxCell><mxCell id="c5" value="Route 53&#xa;ecs.abhidemosite.link&#xa;(existing zone, looked up)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=